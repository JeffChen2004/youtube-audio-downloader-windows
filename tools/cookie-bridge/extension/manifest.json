{
  "manifest_version": 3,
  "name": "YouTube Cookie Bridge",
  "version": "0.1.0",
  "description": "Exports only YouTube and Google account cookies to a local native host.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "alarms",
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.google.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "YouTube Cookie Bridge",
    "default_popup": "popup.html"
  }
}
