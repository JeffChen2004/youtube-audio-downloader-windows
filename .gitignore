# Local dependencies and downloaded media
/tools/*
/downloads/
*.opus
*.webm
*.mp3
*.m4a
*.flac
*.wav
*.part
*.ytdl

# Authentication files: never commit browser sessions
/data/auth/
/data/tracked-playlists/
*cookie*
*Cookie*
*.txt

# Runtime logs and temporary files
*.log
*.tmp
*.zip

# Keep the Cookie Bridge source, but never its compiled output or credentials.
!/tools/cookie-bridge/
!/tools/cookie-bridge/**
/tools/cookie-bridge/dist/
